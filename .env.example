# Chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Postgres (Neon) — v1.0 (SPEC-v1.0). Bí mật.
DATABASE_URL=

# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie đăng nhập. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mật khẩu từng người đặt bằng: npm run user:password -- <email> "<tên>"
AUTH_SECRET=

# Tùy chọn: hạn mặc định (YYYY-MM-DD) cho thẻ đếm ngược của người dùng đầu tiên khi chưa đặt hạn ở Cài đặt.
THESIS_DEADLINE=

# Các biến GOOGLE_* (lịch Google "Next up") hiện KHÔNG được đọc: tính năng đang ẩn từ v1.0.
# Nếu làm lại (SPEC.md mục 10.3) thì chỉ cần GOOGLE_CLIENT_ID và GOOGLE_CLIENT_SECRET.
