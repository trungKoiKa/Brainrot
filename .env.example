# Postgres (Neon) — v1.0 (SPEC-v1.0). Bí mật.
DATABASE_URL=

# Chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Notion internal integration token (tạo tại https://www.notion.so/my-integrations)
NOTION_TOKEN=
NOTION_TASKS_DB=
NOTION_KNOWLEDGE_DB=
NOTION_DAILY_DB=
NOTION_IDEAS_DB=
NOTION_ROOT_PAGE=
# Tùy chọn (v0.4): thiếu thì phần đó báo "chưa kết nối"
NOTION_HABITS_DB=
NOTION_GOALS_DB=
NOTION_REFLECTIONS_DB=

# Mật khẩu vào web
APP_PASSWORD=
# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

THESIS_DEADLINE=2026-12-06

# Google Calendar "Next up" (chỉ đọc), tùy chọn.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Nhiều lịch: phân tách bằng dấu phẩy. Bỏ trống = primary
GOOGLE_CALENDAR_IDS=
