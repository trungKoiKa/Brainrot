# Chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Postgres (Neon) — v1.0 (SPEC-v1.0). Bí mật.
DATABASE_URL=

# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie đăng nhập. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mật khẩu từng người đặt bằng: npm run user:password -- <email> "<tên>"
AUTH_SECRET=

THESIS_DEADLINE=2026-12-06

# Google Calendar "Next up" (chỉ đọc), tùy chọn.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Nhiều lịch: phân tách bằng dấu phẩy. Bỏ trống = primary
GOOGLE_CALENDAR_IDS=
